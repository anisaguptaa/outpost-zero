{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start OUTPOST ZERO",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0 --strictPort",
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "outpost-zero-vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*5173.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    }
  ]
}
